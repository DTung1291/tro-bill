# Neon Postgres connection string (bắt buộc)
# Lấy ở dashboard Neon → Connection Details. Server cũng tự nâng các giá trị
# sslmode=require/prefer/verify-ca cũ thành verify-full trước khi kết nối.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full

# Môi trường ứng dụng và nhãn database phải khớp nhau trên staging/production.
# Vercel tự ánh xạ Production → production, Preview → staging nếu bỏ APP_ENV.
APP_ENV=development
DATABASE_ENVIRONMENT=development

# Khóa ký JWT (bắt buộc) — chuỗi ngẫu nhiên dài, GIỮ BÍ MẬT
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Tuỳ chọn: khóa HMAC riêng cho bộ đếm rate limit và dấu vân tay IP.
# Nếu để trống, server dùng JWT_SECRET.
RATE_LIMIT_SECRET=

# Cổng chạy server (tùy chọn, mặc định 3000)
PORT=3000

# Cookie phiên tự bật Secure trên production/Vercel.
# Chỉ đặt false khi chạy local qua HTTP và môi trường bị nhận nhầm là production.
# COOKIE_SECURE=false

# Email giao dịch (bắt buộc trên production).
# Dùng Brevo Free trước; sender phải được xác minh trong Brevo.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxx
EMAIL_FROM=TrọBill <your-verified-email@gmail.com>
APP_URL=https://your-domain.com

# Bí mật xác thực Vercel Cron; tối thiểu 32 ký tự, chỉ đặt ở server/Vercel.
CRON_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Khóa HMAC xác minh webhook thanh toán subscription; tối thiểu 32 ký tự.
# Chỉ lưu ở server/Vercel và hệ thống gửi webhook, không đưa vào frontend.
PAYMENT_WEBHOOK_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Khi có custom domain có thể đổi lại Resend mà không sửa code:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=TrọBill <no-reply@your-domain.com>

# Webhook HTTPS nhận cảnh báo lỗi API/database và lỗi backup (bắt buộc để có alert production).
OPS_ALERT_WEBHOOK_URL=https://alerts.example.com/trobill

# Tuỳ chọn: ghi log JSON cho mọi request. Dù false, request lỗi 5xx vẫn luôn được log.
LOG_REQUESTS=false

# Admin mặc định (tùy chọn) — tự seed lúc khởi động.
# Nếu email chưa tồn tại: tạo mới + phong admin (cần ADMIN_PASSWORD ≥ 6 ký tự).
# Nếu đã tồn tại: chỉ đảm bảo có quyền admin (không đổi mật khẩu).
ADMIN_EMAIL=admin@trobill.local
ADMIN_PASSWORD=doi-mat-khau-nay
